DATABASE_URL=postgresql://playita:REPLACE_LOCALLY@127.0.0.1:5432/playita
PORT=4300
NODE_ENV=development
# Production: explicit HTTPS web origin(s) plus native origins used; no wildcard.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,capacitor://localhost,http://localhost,https://localhost
# Bootstrap only: supply locally, never commit a real password. No default account exists.
PLAYITA_ADMIN_EMAIL=
PLAYITA_ADMIN_PASSWORD=
# Optional future WhatsApp adapter; unset = unavailable, no messages sent.
WHATSAPP_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Google sign-in is disabled when unset. Public OAuth WEB client ID, never an API key.
GOOGLE_WEB_CLIENT_ID=
