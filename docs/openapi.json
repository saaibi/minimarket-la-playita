          "paymentMethod"
        ],
        "additionalProperties": false
      },
      "Order": {
        "type": "object",
        "required": [
          "id",
          "status",
          "paymentStatus",
          "totalCop",
          "clientName",
          "lines"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
