      "post": {
        "security": [],
        "description": "X-Playita-Client obligatorio en mutaciones web; Origin allowlist y Content-Type JSON. Refresh/logout web requieren X-CSRF-Token tomado de playita_csrf. No registrar secretos. Login/guest sujetos a rate limit.",
        "requestBody": {
          "required": true,
