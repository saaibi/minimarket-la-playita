                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 128
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Web: actor + expiración y Set-Cookie HttpOnly, sin tokens en body. Nativo X-Playita-Client:native: actor + accessToken/refreshToken para vault seguro."
          },
          "400": {
