    "/auth/whatsapp/request": {
      "post": {
        "security": [],
        "description": "Puerto futuro opcional, no requerido para comprar. Sin proveedor devuelve 503; habilitar Twilio puede generar costes, no activado en esta entrega.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "phone": {
                    "type": "string",
                    "pattern": "^\\+[1-9]\\d{7,14}$"
                  }
                },
                "required": [
                  "phone"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "challengeId y expiración, nunca código OTP"
          },
          "429": {
            "description": "Error explícito; conflicto no confirma ni reserva un pedido.",
