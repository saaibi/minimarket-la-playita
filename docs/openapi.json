    "/orders/{id}/actions": {
      "post": {
        "description": "Tienda: accept → ready → pay_cash y deliver (pago y preparación separados). Cancel permitido al dueño o tienda antes de cobro. Entregar descuenta una sola vez. Nequi sin integración no puede cobrarse con pay_cash.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Reutilizar la misma clave y mismo body al reintentar. Revisión de conflicto usa clave nueva. Alcance por identidad autenticada; sin vencimiento en este incremento."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "accept",
                      "ready",
                      "pay_cash",
                      "deliver",
                      "cancel"
                    ]
                  }
                },
                "required": [
                  "action"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pedido con snapshot de líneas/precios, reserva confirmada en transacción; no significa pago confirmado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "Error explícito; conflicto no confirma ni reserva un pedido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error explícito; conflicto no confirma ni reserva un pedido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Error explícito; conflicto no confirma ni reserva un pedido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Error explícito; conflicto no confirma ni reserva un pedido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "get": {
        "description": "Recuperación durable tras reconexión; cursor global creciente (string bigint), máximo 200 por respuesta. Comprador: propios + catálogo. Repetir desde último id; Socket.IO solo invalida, REST es la fuente de verdad.",
        "parameters": [
          {
            "in": "query",
            "name": "after",
            "schema": {
              "type": "string",
              "pattern": "^\\d{1,18}$",
              "default": "0"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Eventos posteriores ordenados por id"
          },
          "400": {
            "description": "Error explícito; conflicto no confirma ni reserva un pedido.",
            "content": {
              "application/json": {
                "schema": {
