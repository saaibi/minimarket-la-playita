{
  "openapi": "3.1.0",
  "info": {
    "title": "Minimarket La Playita",
    "version": "0.2.0",
    "description": "Sesiones opacas verificadas contra PostgreSQL (no JWT demo): acceso 5 min, refresh rotatorio 7 días, límite absoluto 30 días y revocación/reuso. Invitado buyer emitido servidor; personal con contraseña y alta admin. Web cookies HttpOnly + CSRF/Origin; nativo secure storage. Google/Apple no conectados; WhatsApp futuro sin proveedor por defecto."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4300"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    },
    {
      "bearer": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Conexión PostgreSQL real disponible"
          }
        }
      }
    },
    "/inventory": {
      "get": {
        "description": "Stock físico/reservado/disponible y presentaciones. Costo solo administrador. Comprador solo productos visibles.",
        "responses": {
          "200": {
            "description": "Catálogo actual",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Error explícito; conflicto no confirma ni reserva un pedido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "get": {
        "description": "Hasta 100 pedidos recientes. Comprador solo propios; tienda todos. Paginación ampliada pendiente.",
        "responses": {
          "200": {
            "description": "Lista de pedidos"
          },
          "401": {
            "description": "Error explícito; conflicto no confirma ni reserva un pedido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Reutilizar la misma clave y mismo body al reintentar. Revisión de conflicto usa clave nueva. Alcance por identidad autenticada; sin vencimiento en este incremento."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderDraft"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pedido con snapshot de líneas/precios, reserva confirmada en transacción; no significa pago confirmado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "Error explícito; conflicto no confirma ni reserva un pedido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error explícito; conflicto no confirma ni reserva un pedido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Error explícito; conflicto no confirma ni reserva un pedido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
